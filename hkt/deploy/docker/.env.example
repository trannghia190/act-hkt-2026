# ==============================================================================
# ACT-HKT 2026 — Mẫu biến môi trường cho Docker Compose
#
# File này chỉ để tham khảo. Khi triển khai, chạy ./deploy-server.sh — nó sẽ
# tự sinh hkt/deploy/docker/.env với mật khẩu & JWT secret ngẫu nhiên.
#
# KHÔNG commit file .env thật (đã nằm trong .gitignore).
# ==============================================================================

# Tên project Compose (tiền tố volume/network)
COMPOSE_PROJECT_NAME=act-hkt

# --- Cổng & phơi bày ---------------------------------------------------------
# Production chỉ nên mở đúng cổng frontend (80/443) ra ngoài.
# 127.0.0.1 = chỉ truy cập được từ chính server (an toàn cho DB/Redis/API).
PUBLISH_HOST=127.0.0.1
POSTGRES_PORT=5432
REDIS_PORT=16379
CORE_PORT=8080
AI_PORT=8000

# Ánh xạ cổng frontend ra host.
#   Không TLS:  0.0.0.0:80:80
#   Có TLS:     127.0.0.1:13000:80   (Caddy giữ 80/443 và proxy vào frontend)
FRONTEND_PUBLISH=0.0.0.0:80:80

# --- Database ----------------------------------------------------------------
POSTGRES_DB=pulse_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=doi-mat-khau-nay
# Nên là chuỗi URL-safe (chữ/số) vì AI service ghép vào URL kết nối.

# --- JWT ---------------------------------------------------------------------
# HS512 cần tối thiểu 64 ký tự. Sinh bằng: openssl rand -hex 32
JWT_SECRET=doi-thanh-chuoi-64-ky-tu-ngau-nhien

# --- Email (SMTP) ------------------------------------------------------------
# Để trống -> email bị bỏ qua kèm cảnh báo trong log.
# MAIL_DEV_LOG=true: in nội dung email ra log thay vì gửi (chỉ dùng khi demo).
MAIL_DEV_LOG=false
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# --- WebAuthn / Passkey ------------------------------------------------------
# RP_ID phải là hostname người dùng truy cập (không gồm scheme/port).
# Passkey chỉ hoạt động trên HTTPS (hoặc localhost). IP thường không hợp lệ.
WEBAUTHN_RP_ID=example.com
WEBAUTHN_RP_NAME=Ascend Tech
WEBAUTHN_ALLOWED_ORIGINS=https://example.com
# Origin pattern động cho tunnel demo (Cloudflare/ngrok). Production nên để trống.
WEBAUTHN_ALLOWED_ORIGIN_PATTERNS=

# --- Web Push (VAPID) --------------------------------------------------------
# Để trống -> sinh khoá tạm mỗi lần khởi động (subscription mất sau restart).
# Production nên tạo khoá cố định. PUSH_ENABLED=false để tắt hẳn.
PUSH_ENABLED=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Khác --------------------------------------------------------------------
NOTIFICATION_RETENTION_DAYS=90

# Chỉ dùng bởi deploy-server.sh để biết lần sau chạy ở chế độ TLS hay không.
TLS_ENABLED=0
SITE_DOMAIN=
