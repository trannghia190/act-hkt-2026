{
  "info": {
    "_postman_id": "face-recognition-api-base64-collection",
    "name": "Face Recognition & Verification (Base64 JSON API)",
    "description": "Pure JSON Base64 API Suite for Face Registration, Update, Delete, 1:1 Verification, and 1:N Identification.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "tenantId",
      "value": "default",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "1111",
      "type": "string"
    },
    {
      "key": "sampleBase64",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Đăng ký & Quản lý (CRUD Base64)",
      "item": [
        {
          "name": "1.1 Đăng ký khuôn mặt mới (Register Base64)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"NV-001\",\n  \"full_name\": \"Nguyen Van A\",\n  \"image_base64\": \"{{sampleBase64}}\",\n  \"tenant_id\": \"{{tenantId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/faces/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "faces",
                "register"
              ]
            }
          }
        },
        {
          "name": "1.2 Cập nhật thông tin / Đổi ảnh (Update Base64)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Nguyen Van A (Cap Nhat)\",\n  \"image_base64\": \"{{sampleBase64}}\",\n  \"tenant_id\": \"{{tenantId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/faces/users/NV-001",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "faces",
                "users",
                "NV-001"
              ]
            }
          }
        },
        {
          "name": "1.3 Xem danh sách nhân viên (List Users)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/faces/users?tenant_id={{tenantId}}&search=&limit=100&offset=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "faces",
                "users"
              ],
              "query": [
                {
                  "key": "tenant_id",
                  "value": "{{tenantId}}"
                },
                {
                  "key": "search",
                  "value": ""
                },
                {
                  "key": "limit",
                  "value": "100"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            }
          }
        },
        {
          "name": "1.4 Xem chi tiết nhân viên (Get User)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/faces/users/{{userId}}?tenant_id={{tenantId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "faces",
                "users",
                "{{userId}}"
              ],
              "query": [
                {
                  "key": "tenant_id",
                  "value": "{{tenantId}}"
                }
              ]
            }
          }
        },
        {
          "name": "1.5 Xóa nhân viên (Delete User)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/faces/users/NV-001?tenant_id={{tenantId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "faces",
                "users",
                "NV-001"
              ],
              "query": [
                {
                  "key": "tenant_id",
                  "value": "{{tenantId}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Xác thực & Nhận diện (Base64)",
      "item": [
        {
          "name": "2.1 Verify 1:1 - Kiểm tra đúng người (Verify Base64)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{userId}}\",\n  \"image_base64\": \"{{sampleBase64}}\",\n  \"tenant_id\": \"{{tenantId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/faces/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "faces",
                "verify"
              ]
            }
          }
        },
        {
          "name": "2.2 Identify 1:N - Nhận diện ai trong cty (Identify Base64)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"image_base64\": \"{{sampleBase64}}\",\n  \"tenant_id\": \"{{tenantId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/faces/identify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "faces",
                "identify"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Kiosk & Webhook",
      "item": [
        {
          "name": "3.1 Cấu hình Webhook Backend (Config)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/config/webhook?tenant_id={{tenantId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "config",
                "webhook"
              ]
            }
          }
        },
        {
          "name": "3.2 Lấy 10 ảnh preview gần nhất",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/captures/recent?limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "captures",
                "recent"
              ]
            }
          }
        }
      ]
    }
  ]
}